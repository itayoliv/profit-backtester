# Copy to .env and fill in. .env is git-ignored and never logged.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# iex (free) or sip (paid subscription required)
ALPACA_FEED=iex

# raw | split | dividend | all
ALPACA_ADJUSTMENT=all

# Optional overrides
# BT_WORKSPACE=./workspace
# BT_MAX_WORKERS=4
# BT_STALE_AFTER_S=120
